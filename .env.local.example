# .env.local.example — copy to .env.local and fill in values.
# Never commit .env.local. Never paste secrets into chat.

# OpenAI / ChatGPT API
OPENAI_API_KEY=sk-replace-with-your-real-key
# OPENAI_MODEL=gpt-4o-mini

# --- Auth mode ---
# Auto: Supabase Auth when NEXT_PUBLIC_SUPABASE_* are set; else DEMO_USERS; else open.
# Force modes:
#   LUME_AUTH=supabase
#   LUME_AUTH=demo
#   LUME_AUTH=none
#
# AUTH_REQUIRED=true|false  (optional override)

# --- Demo login (local regression / private demos only) ---
# DEMO_USERS=tom@example.com:try-mission-1:Tom
# AUTH_SECRET=replace-with-a-long-random-secret

# --- Supabase (required for Phase 2 production auth + persistence) ---
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used in auth email redirects (local / Vercel)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persistence:
#   unset + Supabase configured → supabase (production path)
#   LUME_PERSISTENCE=local → localStorage (dev fixtures; do not use in production)
#   LUME_PERSISTENCE=supabase → force Supabase
# LUME_PERSISTENCE=local
