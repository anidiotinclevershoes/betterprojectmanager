# Lume environment template
# Copy to .env.local — never commit real secrets.
# Never paste secrets into chat.

# =============================================================================
# PUBLIC / BROWSER-SAFE (NEXT_PUBLIC_*)
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   Production example: https://your-app.vercel.app

# =============================================================================
# SERVER-ONLY (never NEXT_PUBLIC_)
# =============================================================================
# OPENAI_API_KEY=sk-replace-with-your-real-key
# OPENAI_MODEL=gpt-4o-mini
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Stripe (Phase 3 — optional until you configure billing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
#
# Trial length in days (default 14). Confirm before production.
# LUME_TRIAL_DAYS=14
#
# Optional AI rate limits (per authenticated user / hour)
# LUME_RATE_LIMIT_CAPTURE_PER_HOUR=60
# LUME_RATE_LIMIT_COACH_PER_HOUR=60
# LUME_RATE_LIMIT_TELL_ME_PER_HOUR=60
# LUME_RATE_LIMIT_TRANSCRIBE_PER_HOUR=40
# LUME_RATE_LIMIT_NEW_PROJECT_PER_HOUR=30

# =============================================================================
# AUTH / PERSISTENCE MODE
# =============================================================================
# Production (NODE_ENV=production):
#   Auth → Supabase (required)
#   Persistence → Supabase (required)
#   Demo auth / localStorage persistence are rejected
#
# Development defaults:
#   Supabase keys present → Supabase auth + persistence
#   Explicit local regression:
#     LUME_AUTH=demo
#     LUME_PERSISTENCE=local
#     DEMO_USERS=you@example.com:password:You
#     AUTH_SECRET=at-least-16-chars-secret
#
# LUME_AUTH=supabase
# LUME_PERSISTENCE=supabase
# AUTH_REQUIRED=true
#
# Dangerous escape hatch (do not use on public production):
# LUME_ALLOW_LOCAL_IN_PRODUCTION=true
