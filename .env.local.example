# OpenAI / ChatGPT API
# Create a key at https://platform.openai.com/api-keys
# (API access is separate from ChatGPT Plus — same OpenAI account can hold both.)
#
# Important:
# - No quotes around the key
# - No spaces around =
# - Replace the whole value with your real key (do not leave sk-...)
OPENAI_API_KEY=sk-replace-with-your-real-key

# Optional: override default model used for tidy-up + coaching
# OPENAI_MODEL=gpt-4o-mini

# --- Demo login (enable for a private cloud preview) ---
# Leave DEMO_USERS unset for open local development.
# For Vercel / shared demos, set both DEMO_USERS and AUTH_SECRET.
#
# Format (comma-separated):
#   email:password
#   email:password:Display Name
# DEMO_USERS=tom@example.com:try-mission-1:Tom,alice@example.com:preview-42:Alice
#
# Random secret used to sign session cookies (16+ characters)
# Generate with: openssl rand -base64 32
# AUTH_SECRET=replace-with-a-long-random-secret
#
# Optional override:
# AUTH_REQUIRED=true   # force login even without DEMO_USERS
# AUTH_REQUIRED=false  # keep app open (do not use on a public URL)

# --- Supabase (Phase 1 production data foundation) ---
# Create a NEW Supabase project named something like "lume" (do not reuse unrelated projects).
# Click-by-click instructions: docs/SUPABASE_SETUP_FOR_TOM.md
#
# Project Settings → API:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
#
# Server/tests only — NEVER prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Persistence mode for the new repository layer.
# Keep "local" until Phase 2 wires authenticated reads/writes into the UI.
# LUME_PERSISTENCE=local
# LUME_PERSISTENCE=supabase
